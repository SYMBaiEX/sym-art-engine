{
  "name": "sym-art-engine",
  "version": "0.1.0",
  "description": "Deterministic, rule-driven engine for layered NFT and generative art collections.",
  "type": "module",
  "license": "MIT",
  "packageManager": "bun@1.4.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "sym": "./dist/cli/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "CODE_OF_CONDUCT.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SYMBaiEX/sym-art-engine.git"
  },
  "bugs": {
    "url": "https://github.com/SYMBaiEX/sym-art-engine/issues"
  },
  "homepage": "https://github.com/SYMBaiEX/sym-art-engine#readme",
  "keywords": [
    "nft",
    "generative-art",
    "pfp",
    "metadata",
    "traits",
    "deterministic"
  ],
  "scripts": {
    "sym": "tsx src/cli/index.ts",
    "build": "node scripts/build.mjs",
    "clean": "node scripts/clean.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "pack:check": "npm pack --dry-run",
    "prepack": "bun run build"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "eslint": "^10.9.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11",
    "yaml": "^2.9.0"
  }
}
